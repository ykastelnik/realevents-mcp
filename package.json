{
  "name": "realevents-mcp",
  "version": "1.0.4",
  "mcpName": "io.github.ykastelnik/realevents",
  "description": "MCP server for RealEvents.co - create and manage events from your AI assistant",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "realevents-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc && node scripts/add-shebang.js",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "events",
    "event-management",
    "realevents",
    "claude",
    "cursor"
  ],
  "author": "RealEvents",
  "license": "MIT",
  "homepage": "https://realevents.co/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/ykastelnik/realevents-mcp"
  },
  "bugs": {
    "url": "https://github.com/ykastelnik/realevents-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-security": "^3.0.1",
    "prettier": "^3.8.3",
    "typescript": "^5.4.0",
    "undici": "^6.19.0",
    "vitest": "^3.2.4"
  }
}
